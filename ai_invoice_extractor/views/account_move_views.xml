<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ai_extractor" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ai.extractor</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Tlačidlo do hlavičky formulára -->
            <xpath expr="//header" position="inside">
                <button name="action_ai_extract_invoice" 
                        string="🤖 AI Vyťažiť faktúru" 
                        type="object" 
                        class="btn-primary" 
                        invisible="state != 'draft' or move_type != 'in_invoice'"/>
            </xpath>

            <!-- Status vyťaženia vedľa čísla faktúry -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="ai_extraction_status" widget="badge" 
                       decoration-success="ai_extraction_status == 'done'"
                       decoration-info="ai_extraction_status == 'in_progress'"
                       decoration-danger="ai_extraction_status == 'failed'"
                       invisible="move_type != 'in_invoice' or ai_extraction_status == 'none'"/>
            </xpath>
        </field>
    </record>
</odoo>
