<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_apoliak_pbs" model="ir.ui.view">
        <field name="name">account.move.form.inherit.apoliak.pbs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="apoliak_variable_symbol" invisible="move_type not in ('out_invoice', 'in_invoice')"/>
                <field name="apoliak_qr_format" invisible="move_type not in ('out_invoice', 'in_invoice')"/>
                <field name="apoliak_qr_image" widget="image" class="oe_avatar" invisible="not apoliak_qr_image"/>
            </xpath>
        </field>
    </record>
</odoo>
