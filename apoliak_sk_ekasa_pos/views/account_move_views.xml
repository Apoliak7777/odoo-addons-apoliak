<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_apoliak_ekasa" model="ir.ui.view">
        <field name="name">account.move.form.inherit.apoliak.ekasa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_register_sk_ekasa"
                        string="🇸🇰 Zaevidovať v e-Kase"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'posted' or ekasa_status == 'registered'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="🇸🇰 Slovenská e-Kasa (FS SR)" name="sk_ekasa_tab" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Identifikátory dokladu Finančnej správy SR">
                            <field name="ekasa_status" widget="badge"
                                   decoration-success="ekasa_status == 'registered'"
                                   decoration-warning="ekasa_status == 'offline'"/>
                            <field name="ekasa_dkp"/>
                            <field name="ekasa_uid"/>
                            <field name="ekasa_okp"/>
                            <field name="ekasa_sent_at"/>
                        </group>
                        <group string="Hardvérové prepojenie (FiskalPRO / Elcom / ORP)">
                            <field name="ekasa_bridge_url"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
